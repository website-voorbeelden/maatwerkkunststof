{% set footerQuoteHref = "#offerte" %}
{% if page.url == "/over-ons/" or page.url == "/privacybeleid/" or page.url == "/bedankt/" or page.url == "/404.html" %}
  {% set footerQuoteHref = "/contact/#offerte" %}
{% endif %}

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="wordmark wordmark-footer" href="/">
        <span>Maatwerk</span><strong>Kunststof.nl</strong>
      </a>
      <p>Kunststof maatwerk voor bedrijven, technische diensten, machinebouwers en particulieren.</p>
    </div>

    <div>
      <h2>Producten</h2>
      <ul class="footer-links">
        <li><a href="/kunststof-blokken-op-maat/">Kunststof blokken op maat</a></li>
        <li><a href="/kunststof-stroken-op-maat/">Kunststof stroken op maat</a></li>
        <li><a href="/kunststof-platen-op-maat/">Kunststof platen op maat</a></li>
        <li><a href="/kunststof-ringen-op-maat/">Kunststof ringen op maat</a></li>
      </ul>
    </div>

    <div>
      <h2>Informatie</h2>
      <ul class="footer-links">
        <li><a href="/over-ons/">Over ons</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacybeleid/">Privacybeleid</a></li>
        <li><button class="footer-cookie-settings" type="button" data-cookie-settings>Cookie-instellingen</button></li>
      </ul>
    </div>

    <div>
      <h2>Direct aanvragen</h2>
      <ul class="footer-links">
        <li><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="{{ footerQuoteHref }}" data-analytics="quote_cta" data-location="footer">Offerte aanvragen</a></li>
        <li><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" data-analytics="whatsapp_click" data-location="footer">WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {% year %} MaatwerkKunststof.nl</p>
    <p>Levering in heel Nederland en België.</p>
  </div>
</footer>
