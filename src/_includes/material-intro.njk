<section class="mat-section" aria-labelledby="mat-intro-title">
  <div class="mat-container mat-intro-grid">
    <div class="mat-copy">
      <div>
        <p class="mat-eyebrow">Materiaal uitgelegd</p>
        <h2 class="mat-heading" id="mat-intro-title">{{ material.introTitle }}</h2>
      </div>
      {% for paragraph in material.introParagraphs %}<p>{{ paragraph | safe }}</p>{% endfor %}
    </div>
    <aside class="mat-facts" aria-label="{{ material.shortName }} in het kort">
      <h3>{{ material.shortName }} in het kort</h3>
      <dl>
        {% for fact in material.facts %}
          <div><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
        {% endfor %}
      </dl>
      <a href="#offerte">Bespreek uw toepassing →</a>
    </aside>
  </div>
</section>
