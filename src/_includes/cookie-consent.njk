<section class="cookie-consent" data-cookie-consent hidden aria-label="Cookievoorkeuren">
  <div class="cookie-consent__panel" data-cookie-summary>
    <button class="cookie-consent__close" type="button" data-cookie-close aria-label="Cookiemelding sluiten">&times;</button>
    <div class="cookie-consent__copy">
      <h2>Wij gebruiken cookies</h2>
      <p>We gebruiken cookies om de website goed te laten werken en uw ervaring te verbeteren. <a href="/privacybeleid/">Meer informatie</a>.</p>
    </div>
    <div class="cookie-consent__actions">
      <button class="cookie-consent__button cookie-consent__button--accept" type="button" data-cookie-accept>Accepteren</button>
      <button class="cookie-consent__button cookie-consent__button--reject" type="button" data-cookie-reject>Afwijzen</button>
    </div>
  </div>
</section>
