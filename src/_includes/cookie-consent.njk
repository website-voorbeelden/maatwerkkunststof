<section class="cookie-consent" data-cookie-consent hidden aria-label="Cookievoorkeuren">
  <div class="cookie-consent__panel" data-cookie-summary>
    <button class="cookie-consent__close" type="button" data-cookie-close aria-label="Cookiemelding sluiten">&times;</button>
    <div class="cookie-consent__copy">
      <p class="cookie-consent__eyebrow">Cookies</p>
      <h2>Gaat u akkoord met het gebruik van cookies?</h2>
      <p>We gebruiken cookies om de website goed te laten werken en te verbeteren. <a href="/privacybeleid/">Lees meer</a>.</p>
    </div>
    <div class="cookie-consent__actions">
      <button class="cookie-consent__button cookie-consent__button--accept" type="button" data-cookie-accept>Alles accepteren</button>
      <button class="cookie-consent__button cookie-consent__button--preferences" type="button" data-cookie-preferences>Voorkeuren instellen</button>
    </div>
  </div>

  <div class="cookie-consent__panel cookie-consent__panel--preferences" data-cookie-preferences-panel hidden>
    <button class="cookie-consent__close" type="button" data-cookie-close aria-label="Cookievoorkeuren sluiten">&times;</button>
    <div class="cookie-consent__copy">
      <p class="cookie-consent__eyebrow">Cookievoorkeuren</p>
      <h2>Kies uw voorkeur</h2>
    </div>
    <div class="cookie-consent__options">
      <div class="cookie-consent__option">
        <div>
          <strong>Noodzakelijk</strong>
          <p>Nodig voor basisfuncties en om uw keuze te onthouden.</p>
        </div>
        <span class="cookie-consent__always">Altijd actief</span>
      </div>
      <label class="cookie-consent__option" for="cookie-analytics">
        <div>
          <strong>Extra cookies</strong>
          <p>Helpen ons de website te verbeteren.</p>
        </div>
        <span class="cookie-consent__toggle">
          <input id="cookie-analytics" type="checkbox" data-cookie-analytics>
          <span aria-hidden="true"></span>
        </span>
      </label>
    </div>
    <div class="cookie-consent__actions cookie-consent__actions--preferences">
      <button class="cookie-consent__button cookie-consent__button--accept" type="button" data-cookie-save>Keuze opslaan</button>
      <button class="cookie-consent__back" type="button" data-cookie-back>Terug</button>
    </div>
  </div>
</section>
