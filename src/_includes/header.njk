<style>
  .wordmark-logo {
    display: none !important;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    font-family: inherit;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark .wordmark-text {
    display: block !important;
    margin: 0;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.055em;
  }

  .wordmark-dot {
    color: var(--orange-500);
  }

  @media (max-width: 767px) {
    .header-inner {
      position: relative;
    }

    .wordmark {
      position: absolute;
      top: 50%;
      left: 50%;
      align-items: center;
      text-align: center;
      white-space: nowrap;
      transform: translate(-50%, -50%);
    }

    .menu-toggle {
      margin-left: auto;
    }
  }
</style>

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="MaatwerkKunststof.nl – home">
      <span class="wordmark-text">Maatwerk</span>
      <span class="wordmark-text">Kunststof<span class="wordmark-dot">.</span>nl</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Menu openen">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-navigation" aria-label="Hoofdnavigatie">
      <ul>
        {% for item in navigation %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a class="button button-small" href="#offerte" data-analytics="quote_cta" data-location="header">Offerte aanvragen</a>
    </nav>
  </div>
</header>
