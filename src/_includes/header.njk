{% set headerQuoteHref = "#offerte" %}
{% if page.url == "/privacybeleid/" or page.url == "/bedankt/" or page.url == "/404.html" %}
  {% set headerQuoteHref = "/contact/#offerte" %}
{% endif %}

<header class="site-header" data-header>
  <div class="container header-inner">
    <div class="header-left">
      <a class="wordmark" href="/" aria-label="MaatwerkKunststof.nl – home">
        <span class="wordmark-text"><span class="wordmark-accent">Maatwerk</span><span>Kunststof<span class="wordmark-dot">.</span>nl</span></span>
      </a>

      <nav class="site-nav" id="site-navigation" aria-label="Hoofdnavigatie">
        <ul class="site-nav-products">
          {% for item in navigation %}
            <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>

        <ul class="site-nav-utility">
          <li><a href="/over-ons/">Over ons</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>

        <a class="button button-small header-cta" href="{{ headerQuoteHref }}" data-analytics="quote_cta" data-location="header">Offerte aanvragen</a>
      </nav>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Menu openen">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<aside class="site-usp-bar" aria-label="Voordelen van MaatwerkKunststof.nl">
  <div class="container site-usp-inner">
    <ul class="site-usp-list">
      <li>
        <svg viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M19.358 2.981c.788.702.86 1.912.163 2.704L9.68 16.855a1.9 1.9 0 0 1-2.773.084l-6.35-6.383a1.92 1.92 0 0 1 0-2.708 1.9 1.9 0 0 1 2.695 0l5.081 5.043 8.336-9.746a1.9 1.9 0 0 1 2.69-.164Z" fill="currentColor"></path></svg>
        Snel geleverd
      </li>
      <li>
        <svg viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M19.358 2.981c.788.702.86 1.912.163 2.704L9.68 16.855a1.9 1.9 0 0 1-2.773.084l-6.35-6.383a1.92 1.92 0 0 1 0-2.708 1.9 1.9 0 0 1 2.695 0l5.081 5.043 8.336-9.746a1.9 1.9 0 0 1 2.69-.164Z" fill="currentColor"></path></svg>
        Scherpe prijzen
      </li>
      <li>
        <svg viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M19.358 2.981c.788.702.86 1.912.163 2.704L9.68 16.855a1.9 1.9 0 0 1-2.773.084l-6.35-6.383a1.92 1.92 0 0 1 0-2.708 1.9 1.9 0 0 1 2.695 0l5.081 5.043 8.336-9.746a1.9 1.9 0 0 1 2.69-.164Z" fill="currentColor"></path></svg>
        Klantgericht advies
      </li>
      <li>
        <svg viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M19.358 2.981c.788.702.86 1.912.163 2.704L9.68 16.855a1.9 1.9 0 0 1-2.773.084l-6.35-6.383a1.92 1.92 0 0 1 0-2.708 1.9 1.9 0 0 1 2.695 0l5.081 5.043 8.336-9.746a1.9 1.9 0 0 1 2.69-.164Z" fill="currentColor"></path></svg>
        Specialist in maatwerk
      </li>
    </ul>

    <div class="site-usp-links">
      {% if site.trustmark and site.trustmark.image %}
        <img src="{{ site.trustmark.image }}" alt="{{ site.trustmark.alt or 'Webshopkeurmerk' }}" width="92" height="32">
      {% endif %}
      <a href="/over-ons/">Over ons</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
</aside>
