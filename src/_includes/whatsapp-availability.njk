    class="whatsapp-availability__button"
    href="https://wa.me/{{ site.whatsapp }}?text=Hallo%2C%20ik%20heb%20een%20korte%20vraag%20over%20kunststof%20op%20maat."
    target="_blank"
    rel="noopener"
    data-analytics="whatsapp_click"
    data-location="availability_widget"
  >
