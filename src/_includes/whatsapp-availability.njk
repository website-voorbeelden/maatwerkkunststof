  <button class="whatsapp-availability__toggle" type="button" data-whatsapp-availability-toggle aria-expanded="false">
    <span class="whatsapp-availability__toggle-dot" aria-hidden="true"></span>
    <span>Stel uw vraag</span>
  </button>
  <button class="whatsapp-availability__close" type="button" data-whatsapp-availability-close aria-label="WhatsApp-melding sluiten">×</button>
  <div class="whatsapp-availability__copy">
    <h2>Een korte vraag?</h2>
  </div>
  <div class="whatsapp-availability__status">
    <span class="whatsapp-availability__status-label"><i aria-hidden="true"></i>Medewerker online</span>
    <span>Verwachte reactietijd: <strong>5 min.</strong></span>
  </div>
