{% set conversion = material.conversion %}

<article class="mat-article-hero" aria-labelledby="{{ conversion.prefix }}-title">
  <div class="mat-container mat-article-hero-grid">
    <div class="mat-article-hero-copy">
      <p class="mat-eyebrow">{{ conversion.eyebrow }}</p>
      <h1 id="{{ conversion.prefix }}-title">{{ conversion.title }}</h1>
      <p class="mat-article-lead">{{ conversion.lead }}</p>
      <div class="mat-article-actions">
        <a class="mat-button" href="#offerte" data-analytics="quote_cta" data-location="{{ material.analyticsPrefix }}_hero">Vraag {{ material.shortName }} op maat aan</a>
        {% if site.whatsapp %}
          <a class="mat-whatsapp-button" href="https://wa.me/{{ site.whatsapp }}?text={{ conversion.whatsappText }}" target="_blank" rel="noopener" data-analytics="whatsapp_click" data-location="{{ material.analyticsPrefix }}_hero">
            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M16.75 13.96c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.24-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29M12.05 21.5H12c-1.79 0-3.54-.5-5.04-1.43L2 21.5l1.45-4.84A9.8 9.8 0 0 1 1.9 11.5C1.9 5.98 6.4 1.5 11.95 1.5c2.64 0 5.13 1.03 7 2.88a9.78 9.78 0 0 1 2.9 6.97c0 5.52-4.5 10-9.8 10.15"></path></svg>
            WhatsApp
          </a>
        {% endif %}
      </div>
    </div>
    <figure class="mat-article-visual">
      <img src="{{ conversion.images[0].src }}" width="{{ conversion.images[0].width or 1200 }}" height="{{ conversion.images[0].height or 1200 }}" alt="{{ conversion.images[0].alt }}" sizes="(min-width: 900px) 44vw, calc(100vw - 32px)" fetchpriority="high">
      <figcaption>Voorbeelden van {{ material.shortName }} maatwerk: van plaat en strook tot een volledig bewerkt onderdeel.</figcaption>
    </figure>
  </div>
</article>

{% if not material.introAfterApplications %}
  {% include "material-intro.njk" %}
{% endif %}

{% if material.grades %}
<section class="mat-section mat-soft" aria-labelledby="mat-grades-title">
  <div class="mat-container mat-longform">
    <p class="mat-eyebrow">{{ material.gradesEyebrow or "Materiaalsoorten" }}</p>
    <h2 class="mat-heading" id="mat-grades-title">{{ material.gradesTitle }}</h2>
    <p class="mat-longform-lead">{{ material.gradesIntro }}</p>
    <div class="mat-grade-article">
      {% for grade in material.grades %}
        <section>
          <h3>{{ grade.title }}</h3>
          {% for paragraph in grade.paragraphs %}<p>{{ paragraph | safe }}</p>{% endfor %}
        </section>
      {% endfor %}
    </div>
    {% if material.gradesNote %}<p class="mat-grade-note">{{ material.gradesNote }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if material.forms %}
<section class="mat-section" aria-labelledby="mat-forms-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Vormen en producten</p><h2 class="mat-heading" id="mat-forms-title">{{ material.formsTitle }}</h2></div>
      <p>{{ material.formsIntro }}</p>
    </div>
    <div class="mat-shape-list">
      {% for form in material.forms %}
        <article>
          <h3>{% if form.url %}<a href="{{ form.url }}">{{ form.title }} <span aria-hidden="true">→</span></a>{% else %}{{ form.title }}{% endif %}</h3>
          <p>{{ form.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if material.spotlightTitle %}
<section class="mat-section mat-soft" aria-labelledby="mat-spotlight-title">
  <div class="mat-container{% if not material.spotlightImage %} mat-longform{% endif %}">
    <div class="mat-spotlight-layout">
      <div>
        <p class="mat-eyebrow">{{ material.spotlightEyebrow or "Uitgelicht" }}</p>
        <h2 class="mat-heading" id="mat-spotlight-title">{{ material.spotlightTitle }}</h2>
        <div class="mat-editorial-copy">
          {% for paragraph in material.spotlightParagraphs %}<p>{{ paragraph | safe }}</p>{% endfor %}
        </div>
      </div>
      {% if material.spotlightImage %}
        <figure class="mat-spotlight-image">
          <img src="{{ material.spotlightImage.src }}" width="{{ material.spotlightImage.width }}" height="{{ material.spotlightImage.height }}" alt="{{ material.spotlightImage.alt }}" loading="lazy" decoding="async">
        </figure>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if material.examples %}
<section class="mat-section{% if not material.examplesPlain %} mat-soft{% endif %}" aria-labelledby="mat-examples-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Uit de praktijk</p><h2 class="mat-heading" id="mat-examples-title">{{ material.examplesTitle }}</h2></div>
      {% if material.examplesIntro %}<p>{{ material.examplesIntro }}</p>{% endif %}
    </div>
    {% if material.examplesFeature %}
      <article class="mat-example-feature">
        <div class="mat-example-feature-media">
          {% for image in material.examples[0].images %}<figure><img src="{{ image.src }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}" loading="lazy" decoding="async"></figure>{% endfor %}
        </div>
        <dl class="mat-example-feature-details">
          {% for detail in material.examples[0].details %}
            <div><dt>{{ detail.label }}</dt><dd>{{ detail.value }}</dd></div>
          {% endfor %}
        </dl>
      </article>
    {% elif material.examplesCompactPair %}
      <div class="mat-example-process{% if material.examplesCompactPairNoArrow %} without-arrow{% endif %}" aria-label="Model en uitgevoerd onderdeel">
        <figure><img src="{{ material.examples[0].images[0].src }}" width="{{ material.examples[0].images[0].width }}" height="{{ material.examples[0].images[0].height }}" alt="{{ material.examples[0].images[0].alt }}" loading="lazy" decoding="async"></figure>
        {% if not material.examplesCompactPairNoArrow %}<span aria-hidden="true">→</span>{% endif %}
        <figure><img src="{{ material.examples[0].images[1].src }}" width="{{ material.examples[0].images[1].width }}" height="{{ material.examples[0].images[1].height }}" alt="{{ material.examples[0].images[1].alt }}" loading="lazy" decoding="async"></figure>
      </div>
    {% else %}
    <div class="mat-example-grid">
      {% for example in material.examples %}
        <article class="mat-example-card{% if example.images %} is-wide{% endif %}">
          {% if example.images %}
            <div class="mat-example-media-pair">
              {% for image in example.images %}<img src="{{ image.src }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}" loading="lazy" decoding="async">{% endfor %}
            </div>
          {% else %}
            <img src="{{ example.image }}" width="{{ example.width }}" height="{{ example.height }}" alt="{{ example.alt }}" loading="lazy" decoding="async">
          {% endif %}
          <div class="mat-example-copy"><h3>{{ example.title }}</h3><p>{{ example.text }}</p></div>
        </article>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="mat-section" aria-labelledby="mat-processing-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Bewerkbaarheid</p><h2 class="mat-heading" id="mat-processing-title">{{ material.processingTitle }}</h2></div>
      <p>{{ material.processingIntro }}</p>
    </div>
    <div class="mat-process-table" role="list" aria-label="Bewerkingen voor {{ material.shortName }}">
      {% for operation in material.operations %}
        <article class="mat-process-row is-{{ operation.status }}" role="listitem">
          <div class="mat-process-name"><strong>{{ operation.name }}</strong><span>{{ operation.label }}</span></div>
          <p>{{ operation.text }}</p>
        </article>
      {% endfor %}
    </div>
    <p class="mat-disclaimer">{{ material.processingNote }}</p>
  </div>
</section>

{% if material.properties %}
<section class="mat-section mat-soft" aria-labelledby="mat-properties-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Eigenschappen en keuze</p><h2 class="mat-heading" id="mat-properties-title">{{ material.propertiesTitle }}</h2></div>
      <p>{{ material.propertiesIntro }}</p>
    </div>
    <div class="mat-card-grid mat-property-grid">
      {% for property in material.properties %}
        <article class="mat-property-card"><h3>{{ property.title }}</h3><p>{{ property.text }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if material.applications %}
<section class="mat-section" aria-labelledby="mat-applications-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Praktijk</p><h2 class="mat-heading" id="mat-applications-title">{{ material.applicationsTitle }}</h2></div>
      <p>{{ material.applicationsIntro }}</p>
    </div>
    <div class="mat-card-grid mat-application-grid">
      {% for application in material.applications %}
        <article class="mat-application-card"><h3>{{ application.title }}</h3><p>{{ application.text }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if material.introAfterApplications %}
  {% include "material-intro.njk" %}
{% endif %}

{% if material.editorialTitle %}
<section class="mat-section mat-soft" aria-labelledby="mat-editorial-title">
  <div class="mat-container mat-longform">
    <p class="mat-eyebrow">Keuze en toepassing</p>
    <h2 class="mat-heading" id="mat-editorial-title">{{ material.editorialTitle }}</h2>
    <div class="mat-editorial-copy">
      {% for paragraph in material.editorialParagraphs %}<p>{{ paragraph | safe }}</p>{% endfor %}
    </div>
    {% if material.sourceNote %}<p class="mat-disclaimer">{{ material.sourceNote }}</p>{% endif %}
  </div>
</section>
{% endif %}

<section class="mat-section mat-soft" aria-labelledby="mat-price-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Kosten en aantallen</p><h2 class="mat-heading" id="mat-price-title">{{ material.priceTitle }}</h2></div>
      <p>{{ material.priceIntro }}</p>
    </div>
    <div class="mat-price-grid">
      <div class="mat-price-copy">
        {% for paragraph in material.priceParagraphs %}<p>{{ paragraph }}</p>{% endfor %}
        <div class="mat-price-factors">
          {% for factor in material.priceFactors %}
            <div><strong>{{ factor.title }}</strong><span>{{ factor.text }}</span></div>
          {% endfor %}
        </div>
      </div>
      <aside class="mat-price-note"><h3>{{ material.priceNoteTitle }}</h3><p>{{ material.priceNote }}</p><a href="#offerte">Vraag een vrijblijvende prijs aan →</a></aside>
    </div>
  </div>
</section>

{% if material.comparisons %}
<section class="mat-section" aria-labelledby="mat-compare-title">
  <div class="mat-container mat-compare-grid">
    <div class="mat-copy">
      <div><p class="mat-eyebrow">Materiaalkeuze</p><h2 class="mat-heading" id="mat-compare-title">{{ material.compareTitle }}</h2></div>
      {% for paragraph in material.compareParagraphs %}<p>{{ paragraph }}</p>{% endfor %}
    </div>
    <div class="mat-compare-list">
      {% for comparison in material.comparisons %}
        <article><h3>{{ comparison.title }}</h3><p>{{ comparison.text }}</p>{% if comparison.url %}<a href="{{ comparison.url }}">{{ comparison.linkLabel }} →</a>{% endif %}</article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if material.requestSteps %}
<section class="mat-section mat-soft" aria-labelledby="mat-request-title">
  <div class="mat-container">
    <div class="mat-section-head">
      <div><p class="mat-eyebrow">Van vraag naar onderdeel</p><h2 class="mat-heading" id="mat-request-title">{{ material.requestTitle }}</h2></div>
      <p>{{ material.requestIntro }}</p>
    </div>
    <div class="mat-request-grid">
      {% for step in material.requestSteps %}
        <article class="mat-request-card"><span aria-hidden="true">{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="mat-section" aria-labelledby="mat-faq-title">
  <div class="mat-container mat-faq-grid">
    <div><p class="mat-eyebrow">Veelgestelde vragen</p><h2 class="mat-heading" id="mat-faq-title">{{ material.faqTitle }}</h2></div>
    <div class="mat-faq-list">
      {% for faq in material.faqs %}
        <details><summary>{{ faq.question }}</summary><p>{{ faq.answer }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>

{% set quoteProduct = material.shortName + " op maat" %}
{% set quoteTitle = material.finalTitle %}
{% set quoteIntro = material.finalText %}
{% set quotePlaceholder = "Vertel kort wat u nodig heeft. Een globale maat of eenvoudige omschrijving is al genoeg." %}
{% set quoteHidePrivacyCheckbox = true %}
{% set quoteCompact = true %}
{% set quoteLight = material.quoteLight or false %}
{% include "offerte-form.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ material.schemaName | json | safe }},
  "provider": {"@type":"Organization","name":"MaatwerkKunststof.nl","url":"https://maatwerkkunststof.nl"},
  "areaServed": ["Nederland", "België"],
  "serviceType": {{ material.serviceType | json | safe }},
  "description": {{ material.schemaDescription | json | safe }}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"https://maatwerkkunststof.nl/"},
    {"@type":"ListItem","position":2,"name":{{ material.shortName | json | safe }},"item":{{ ("https://maatwerkkunststof.nl" + page.url) | json | safe }}}
  ]
}
</script>
