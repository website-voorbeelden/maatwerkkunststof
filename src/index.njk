    font-size: 0.82rem;
    font-weight: 760;
    text-decoration-color: var(--mkh-orange);
    text-underline-offset: 4px;
  }

  /* Hero */

  .mkh-hero {
    padding: 46px 0 58px;
    background: var(--mkh-white);
  }

  .mkh-hero-grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .mkh-hero-copy {
    max-width: 700px;
  }

  .mkh-hero h1 {
    max-width: 790px;
    margin: 0 0 21px;
    color: var(--mkh-dark);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 790;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .mkh-hero-lead {
    max-width: 670px;
    margin: 0 0 25px;
    color: var(--mkh-text);
    font-size: clamp(1.03rem, 2vw, 1.2rem);
    line-height: 1.68;
  }

  .mkh-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .mkh-hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mkh-hero-points li {
    position: relative;
    padding-left: 19px;
    color: var(--mkh-dark);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .mkh-hero-points li::before {
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--mkh-orange);
    content: "";
  }

  .mkh-hero-image {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 18px;
    background: var(--mkh-soft);
  }

  .mkh-hero-image img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
  }

  /* Contact row */

  .mkh-contact-row {
    border-top: 1px solid var(--mkh-line);
    border-bottom: 1px solid var(--mkh-line);
    background: var(--mkh-white);
  }

  .mkh-contact-inner {
    display: grid;
    gap: 12px;
    padding-block: 19px;
  }

  .mkh-contact-inner strong {
    display: block;
    margin-bottom: 2px;
    color: var(--mkh-dark);
    font-size: 0.92rem;
  }

  .mkh-contact-inner span {
    color: var(--mkh-muted);
    font-size: 0.79rem;
  }

  .mkh-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 20px;
  }

  .mkh-contact-links a {
    color: var(--mkh-dark);
    font-size: 0.82rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .mkh-contact-links .mkh-whatsapp-link {
    color: var(--mkh-green-dark);
  }

  /* Product cards */

  .mkh-product-grid {
    display: grid;
    gap: 18px;
  }

  .mkh-product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    background: var(--mkh-white);
  }

  .mkh-product-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    padding: 14px;
    background: var(--mkh-soft);
  }

  .mkh-product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mkh-product-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 21px;
  }

  .mkh-product-copy h3 {
    margin: 0 0 8px;
    color: var(--mkh-dark);
    font-size: 1.18rem;
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .mkh-product-copy h3 a {
    text-decoration: none;
  }

  .mkh-product-copy p {
    margin: 0 0 16px;
    color: var(--mkh-text);
    font-size: 0.87rem;
    line-height: 1.58;
  }

  .mkh-product-copy .mkh-link {
    margin-top: auto;
  }

  /* Maatwerk */

  .mkh-custom-grid {
    display: grid;
    gap: 34px;
    align-items: center;
  }

  .mkh-square-image {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 16px;
    background: var(--mkh-soft);
  }

  .mkh-square-image img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
  }

  .mkh-custom-copy p {
    margin: 18px 0 0;
    color: var(--mkh-text);
    line-height: 1.7;
  }

  .mkh-simple-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
    margin: 25px 0 29px;
    padding: 0;
    list-style: none;
  }

  .mkh-simple-list li {
    position: relative;
    padding-left: 21px;
    color: var(--mkh-dark);
    font-size: 0.84rem;
    font-weight: 680;
  }

  .mkh-simple-list li::before {
    position: absolute;
    top: 0.57em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--mkh-orange);
    content: "";
  }

  /* Materials */

  .mkh-material-grid {
    display: grid;
    gap: 34px;
  }

  .mkh-material-copy p {
    margin: 18px 0 0;
    color: var(--mkh-text);
    line-height: 1.7;
  }

  .mkh-material-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .mkh-material-list span {
    display: flex;
    min-height: 44px;
    align-items: center;
    border: 1px solid var(--mkh-line);
    border-radius: 7px;
    padding: 9px 12px;
    color: var(--mkh-dark);
    background: var(--mkh-white);
    font-size: 0.77rem;
    font-weight: 700;
  }

  /* Applications */

  .mkh-application-grid {
    display: grid;
    gap: 12px;
  }

  .mkh-application-card {
    border: 1px solid var(--mkh-line);
    border-radius: 9px;
    padding: 21px;
    background: var(--mkh-white);
  }

  .mkh-application-card h3 {
    margin: 0 0 7px;
    color: var(--mkh-dark);
    font-size: 1rem;
  }

  .mkh-application-card p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  /* Process */

  .mkh-process-grid {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mkh-process-card {
    border-top: 3px solid var(--mkh-orange);
    padding: 21px 0 0;
  }

  .mkh-process-number {
    display: block;
    margin-bottom: 18px;
    color: var(--mkh-orange);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .mkh-process-card h3 {
    margin: 0 0 7px;
    color: var(--mkh-dark);
    font-size: 1.05rem;
  }

  .mkh-process-card p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  /* SEO text */

  .mkh-seo-grid {
    display: grid;
    gap: 24px;
  }

  .mkh-seo-copy p {
    margin: 0 0 17px;
    color: var(--mkh-text);
    line-height: 1.72;
  }

  .mkh-seo-copy a {
    color: var(--mkh-dark);
    font-weight: 720;
    text-decoration-color: var(--mkh-orange);
    text-underline-offset: 4px;
  }

  /* FAQ */

  .mkh-faq-grid {
    display: grid;
    gap: 30px;
  }

  .mkh-faq-list {
    border-top: 1px solid var(--mkh-line);
  }

  .mkh-faq-list details {
    border-bottom: 1px solid var(--mkh-line);
  }

  .mkh-faq-list summary {
    position: relative;
    padding: 19px 38px 19px 0;
    color: var(--mkh-dark);
    font-size: 0.9rem;
    font-weight: 730;
    cursor: pointer;
    list-style: none;
  }

  .mkh-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .mkh-faq-list summary::after {
    position: absolute;
    top: 15px;
    right: 3px;
    color: var(--mkh-orange);
    content: "+";
    font-size: 1.4rem;
  }

  .mkh-faq-list details[open] summary::after {
    content: "−";
  }

  .mkh-faq-list p {
    max-width: 720px;
    margin: 0 0 20px;
    padding-right: 25px;
    color: var(--mkh-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* Final CTA */

  .mkh-final-cta {
    padding: 56px 0;
    border-top: 1px solid var(--mkh-line);
    background: var(--mkh-white);
  }

  .mkh-final-grid {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  .mkh-final-grid h2 {
    max-width: 700px;
    margin: 0;
    color: var(--mkh-dark);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .mkh-final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Bestaand offerteformulier lichter maken */

  body.mkh-home .quote-section {
    color: var(--mkh-dark);
    background: var(--mkh-soft);
  }

  body.mkh-home .quote-intro h2,
  body.mkh-home .quote-intro p {
    color: var(--mkh-dark);
  }

  body.mkh-home .quote-intro > p:not(.eyebrow) {
    color: var(--mkh-text);
  }

  body.mkh-home .quote-form {
    border: 1px solid var(--mkh-line);
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .mkh-container {
      width: min(calc(100% - 48px), var(--mkh-container));
    }

    .mkh-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mkh-material-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkh-application-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mkh-process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }

  @media (min-width: 900px) {
    .mkh-hero {
      padding: 72px 0 82px;
    }

    .mkh-hero-grid {
      grid-template-columns:
        minmax(0, 1.08fr)
        minmax(420px, 0.92fr);
      gap: 76px;
    }

    .mkh-contact-inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .mkh-contact-links {
      justify-content: flex-end;
    }

    .mkh-section {
      padding-block: 96px;
    }

    .mkh-section-intro {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(330px, 0.72fr);
      gap: 60px;
      align-items: end;
      margin-bottom: 42px;
    }

    .mkh-product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkh-product-copy {
      min-height: 220px;
    }

    .mkh-custom-grid {
      grid-template-columns:
        minmax(400px, 0.85fr)
        minmax(0, 1.15fr);
      gap: 76px;
    }

    .mkh-material-grid {
      grid-template-columns:
        minmax(0, 0.8fr)
        minmax(0, 1.2fr);
      gap: 72px;
    }

    .mkh-material-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkh-application-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkh-seo-grid,
    .mkh-faq-grid {
      grid-template-columns:
        minmax(0, 0.72fr)
        minmax(0, 1.28fr);
      gap: 80px;
    }

    .mkh-final-grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .mkh-final-actions {
      justify-content: flex-end;
    }
  }
</style>

<section class="mkh-hero" aria-labelledby="mkh-hero-title">
  <div class="mkh-container mkh-hero-grid">
    <div class="mkh-hero-copy">
      <p class="mkh-eyebrow">
        Kunststof maatwerk
      </p>

      <h1 id="mkh-hero-title">
        Kunststof op maat voor iedere toepassing
      </h1>

      <p class="mkh-hero-lead">
        Wij leveren kunststof blokken, stroken, platen, ringen en volledig
        bewerkte onderdelen. Van één eenvoudig maatdeel tot grotere
        productieseries.
      </p>

      <div class="mkh-hero-actions">
        <a
          class="mkh-btn"
          href="#offerte"
          data-analytics="quote_cta"
          data-location="home_hero"
        >
          Vraag een offerte aan
        </a>

        {% if site.whatsapp %}
          <a
            class="mkh-btn mkh-btn-whatsapp"
            href="https://wa.me/{{ site.whatsapp }}?text=Hallo%2C%20ik%20wil%20graag%20kunststof%20op%20maat%20laten%20maken."
            target="_blank"
            rel="noopener"
            data-analytics="whatsapp_click"
            data-location="home_hero"
          >
            WhatsApp
          </a>
        {% endif %}
      </div>

      <ul class="mkh-hero-points">
        <li>Enkelstuks en series</li>
        <li>Vrijwel iedere kunststof</li>
        <li>Volledig op maat bewerkt</li>
      </ul>
    </div>

    <figure class="mkh-hero-image">
      <img
        src="/assets/images/kunststof-blokken-andere-hoek.webp"
        width="900"
        height="900"
        alt="Kunststof blokken en plaatdelen op maat"
        fetchpriority="high"
      >
    </figure>
  </div>
</section>

<section class="mkh-contact-row" aria-label="Contactgegevens">
  <div class="mkh-container mkh-contact-inner">
    <div>
      <strong>Een kunststof onderdeel nodig?</strong>
      <span>Stuur uw maten, foto of technische tekening.</span>
    </div>

    <div class="mkh-contact-links">
      <a href="mailto:{{ contactEmail }}">
        {{ contactEmail }}
      </a>

      {% if site.phone %}
        <a href="tel:{{ site.phone }}">
          {{ site.phoneDisplay }}
        </a>
      {% endif %}

      {% if site.whatsapp %}
        <a
          class="mkh-whatsapp-link"
          href="https://wa.me/{{ site.whatsapp }}?text=Hallo%2C%20ik%20heb%20een%20vraag%20over%20kunststof%20op%20maat."
          target="_blank"
          rel="noopener"
        >
          WhatsApp
        </a>
      {% endif %}
    </div>
  </div>
</section>

