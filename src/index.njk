  .mkh-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--mkh-orange);
    border-radius: 7px;
    padding: 13px 20px;
    color: var(--mkh-white);
    background: var(--mkh-orange);
    font-size: 0.92rem;
    font-weight: 760;
    line-height: 1.2;
    text-align: center;
