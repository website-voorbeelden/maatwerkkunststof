        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        >
      </div>

      <div class="mkh-form-grid">
        <div class="mkh-field">
          <label for="naam">Naam <span aria-hidden="true">*</span></label>
          <input
            id="naam"
            name="naam"
            type="text"
            autocomplete="name"
            required
            maxlength="100"
          >
        </div>

        <div class="mkh-field">
          <label for="bedrijf">Bedrijf</label>
          <input
            id="bedrijf"
            name="bedrijf"
            type="text"
            autocomplete="organization"
            maxlength="120"
          >
        </div>
      </div>

      <div class="mkh-form-grid">
        <div class="mkh-field">
          <label for="email">
            E-mailadres <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="160"
          >
        </div>

        <div class="mkh-field">
          <label for="telefoon">Telefoonnummer</label>
          <input
            id="telefoon"
            name="telefoon"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="40"
          >
        </div>
      </div>

      <div class="mkh-field">
        <label for="specificaties">
          Wat heeft u nodig? <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="specificaties"
          name="specificaties"
          rows="7"
          required
          maxlength="4000"
          placeholder="Bijvoorbeeld: zwarte HDPE blokken van 200 × 100 × 40 mm met twee boorgaten."
        ></textarea>
        <p class="mkh-field-help">
          Een korte omschrijving is voldoende. Ontbrekende details kunnen
          later worden besproken.
        </p>
      </div>

      <div class="mkh-field">
        <label for="bestanden">Foto, schets of technische tekening</label>
        <input
          id="bestanden"
          name="bestanden"
          type="file"
          multiple
          accept=".pdf,.png,.jpg,.jpeg,.webp,.heic,.dxf,.dwg,.step,.stp"
        >
        <p class="mkh-field-help">
          Optioneel. Maximaal 3 bestanden en samen maximaal 8 MB.
        </p>
      </div>

      <div
        class="mkh-form-status form-status"
        role="status"
        aria-live="polite"
        data-form-status
      ></div>

      <button
        class="mkh-btn"
        type="submit"
        data-submit-button
      >
        Offerteaanvraag versturen
      </button>

      <p class="mkh-form-note">
        Vrijblijvend en zonder aankoopverplichting.
      </p>
    </form>
  </div>
