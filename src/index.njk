      gap: 62px;
      align-items: end;
      margin-bottom: 42px;
    }

    .mkx-products {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkx-product-image {
      height: 175px;
    }

    .mkx-product-body {
      min-height: 222px;
      justify-content: flex-start;
    }

    .mkx-product-link {
      margin-top: auto;
    }

    .mkx-capabilities-grid {
      grid-template-columns:
        minmax(0, 0.92fr)
        minmax(430px, 1.08fr);
      gap: 72px;
    }

    .mkx-capability-images {
      grid-template-rows: 205px 205px;
    }

    .mkx-material-grid {
      grid-template-columns:
        minmax(0, 0.85fr)
        minmax(0, 1.15fr);
      gap: 72px;
      align-items: start;
    }

    .mkx-material-tags {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkx-precision-grid {
      grid-template-columns:
        minmax(430px, 0.92fr)
        minmax(0, 1.08fr);
      gap: 76px;
    }

    .mkx-precision-image,
    .mkx-precision-image img {
      min-height: 435px;
    }

    .mkx-applications {
      grid-template-columns: repeat(3, minmax(0, 1fr));
