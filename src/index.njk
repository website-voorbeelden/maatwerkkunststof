---
layout: "base.njk"
title: "Kunststof op maat laten maken | Vrijwel iedere vorm mogelijk"
description: "Kunststof of plastic op maat laten maken in vrijwel iedere 2D- of 3D-vorm. Van één onderdeel tot grotere series in HDPE, POM, PTFE, PU en meer."
image: "/assets/images/kunststof-blokken-andere-hoek.webp"
imageAlt: "Kunststof blokken en technische onderdelen op maat"
preloadImage: "/assets/images/kunststof-blokken-andere-hoek-800.webp"
preloadImageSrcset: "/assets/images/kunststof-blokken-andere-hoek-640.webp 640w, /assets/images/kunststof-blokken-andere-hoek-800.webp 800w"
preloadImageSizes: "(min-width: 1200px) 540px, (min-width: 900px) 46vw, calc(100vw - 32px)"
bodyClass: "mkh-home"
---

{% set contactEmail = site.email or "offerte@maatwerkkunststof.nl" %}

<style>
  body.mkh-home {
    --mkh-ink: #142b33;
    --mkh-text: #536369;
    --mkh-muted: #78858b;
    --mkh-line: #dce2e3;
    --mkh-soft: #f3f7ef;
    --mkh-white: #ffffff;
    --mkh-orange: #74c200;
    --mkh-orange-dark: #4f8f00;
    --mkh-whatsapp: #128c4a;
    --mkh-whatsapp-dark: #0f6f3b;
    --mkh-radius: 12px;
    --mkh-container: 1180px;
    background: var(--mkh-white);
  }

  body.mkh-home main {
    overflow: hidden;
  }

  .mkh-container {
    width: min(calc(100% - 32px), var(--mkh-container));
    margin-inline: auto;
  }

  .mkh-section {
    padding: 68px 0;
  }

  .mkh-section-soft {
    background: var(--mkh-soft);
  }

  .mkh-eyebrow {
    margin: 0 0 10px;
    color: var(--mkh-orange-dark);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .mkh-heading {
    margin: 0;
    color: var(--mkh-ink);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .mkh-section-intro {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  .mkh-section-intro > p {
    max-width: 660px;
    margin: 0;
    color: var(--mkh-text);
    line-height: 1.7;
  }

  .mkh-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--mkh-orange);
    border-radius: 7px;
    padding: 13px 20px;
    color: var(--mkh-white);
    background: var(--mkh-orange);
    font-size: 0.92rem;
    font-weight: 760;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
  }

  .mkh-btn:hover,
  .mkh-btn:focus-visible {
    border-color: var(--mkh-orange-dark);
    background: var(--mkh-orange-dark);
    transform: translateY(-1px);
  }

  .mkh-btn-whatsapp {
    border-color: var(--mkh-line);
    color: var(--mkh-ink);
    background: var(--mkh-white);
  }

  .mkh-btn-whatsapp:hover,
  .mkh-btn-whatsapp:focus-visible {
    border-color: var(--mkh-whatsapp);
    color: var(--mkh-ink);
    background: var(--mkh-soft);
  }

  .mkh-link {
    color: var(--mkh-ink);
    font-size: 0.82rem;
    font-weight: 760;
    text-decoration-color: var(--mkh-orange);
    text-underline-offset: 4px;
  }

  /* Hero */

  .mkh-hero {
    padding: 46px 0 58px;
    background: var(--mkh-white);
  }

  .mkh-hero-grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .mkh-hero-copy {
    max-width: 700px;
  }

  .mkh-hero h1 {
    max-width: 790px;
    margin: 0 0 21px;
    color: var(--mkh-ink);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 790;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .mkh-hero-lead {
    max-width: 670px;
    margin: 0 0 25px;
    color: var(--mkh-text);
    font-size: clamp(1.03rem, 2vw, 1.2rem);
    line-height: 1.68;
  }

  .mkh-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .mkh-hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mkh-hero-points li {
    position: relative;
    padding-left: 19px;
    color: var(--mkh-ink);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .mkh-hero-points li::before {
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--mkh-orange);
    content: "";
  }

  .mkh-hero-image {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 18px;
    background: var(--mkh-soft);
  }

  .mkh-hero-image img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
  }

  /* Van ontwerp naar gecontroleerd onderdeel */

  .mkh-production-grid {
    display: grid;
    gap: 18px;
  }

  .mkh-production-heading {
    margin-bottom: 32px;
  }

  .mkh-production-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    background: var(--mkh-white);
  }

  .mkh-production-card figure {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    background: var(--mkh-white);
  }

  .mkh-production-card figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mkh-production-card:first-child figure img {
    padding: 20px;
    object-fit: contain;
  }

  .mkh-production-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .mkh-production-step {
    margin-bottom: 8px;
    color: var(--mkh-orange-dark);
    font-size: 0.7rem;
    font-weight: 820;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .mkh-production-copy h3 {
    margin: 0 0 9px;
    color: var(--mkh-ink);
    font-size: 1.12rem;
    line-height: 1.3;
  }

  .mkh-production-copy p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  /* Product cards */

  .mkh-product-grid {
    display: grid;
    gap: 18px;
  }

  .mkh-product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    background: var(--mkh-white);
  }

  .mkh-product-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    padding: 14px;
    background: var(--mkh-soft);
  }

  .mkh-product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mkh-product-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 21px;
  }

  .mkh-product-copy h3 {
    margin: 0 0 8px;
    color: var(--mkh-ink);
    font-size: 1.18rem;
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .mkh-product-copy h3 a {
    text-decoration: none;
  }

  .mkh-product-copy p {
    margin: 0 0 16px;
    color: var(--mkh-text);
    font-size: 0.87rem;
    line-height: 1.58;
  }

  .mkh-product-copy .mkh-link {
    margin-top: auto;
  }

  /* Simple image and copy sections */

  .mkh-split {
    display: grid;
    gap: 34px;
    align-items: center;
  }

  .mkh-square-image {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 16px;
    background: var(--mkh-soft);
  }

  .mkh-square-image img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
  }

  .mkh-split-copy p {
    margin: 18px 0 0;
    color: var(--mkh-text);
    line-height: 1.7;
  }

  .mkh-home-longform {
    max-width: 1040px;
  }

  .mkh-home-longform > p:not(.mkh-eyebrow) {
    max-width: 880px;
    margin: 18px 0 0;
    color: var(--mkh-text);
    line-height: 1.75;
  }

  .mkh-detail-columns {
    display: grid;
    gap: 30px;
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid var(--mkh-line);
  }

  .mkh-detail-columns h3 {
    margin: 0 0 10px;
    color: var(--mkh-ink);
    font-size: 1.08rem;
  }

  .mkh-detail-columns p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .mkh-simple-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
    margin: 25px 0 0;
    padding: 0;
    list-style: none;
  }

  .mkh-simple-list li {
    position: relative;
    padding-left: 21px;
    color: var(--mkh-ink);
    font-size: 0.84rem;
    font-weight: 680;
  }

  .mkh-simple-list li::before {
    position: absolute;
    top: 0.57em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--mkh-orange);
    content: "";
  }

  /* Featured materials */

  .mkh-material-showcase {
    display: grid;
    gap: 30px 22px;
  }

  .mkh-material-feature {
    min-width: 0;
    text-align: center;
  }

  .mkh-material-feature > a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .mkh-material-circle {
    overflow: hidden;
    width: min(100%, 320px);
    aspect-ratio: 1;
    margin: 0 auto 18px;
    border: 1px solid var(--mkh-line);
    border-radius: 50%;
    background: var(--mkh-white);
    box-shadow: 0 10px 30px rgba(20, 43, 51, 0.07);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .mkh-material-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .mkh-material-feature > a:hover .mkh-material-circle,
  .mkh-material-feature > a:focus-visible .mkh-material-circle {
    border-color: var(--mkh-orange);
    box-shadow: 0 14px 34px rgba(20, 43, 51, 0.11);
    transform: translateY(-3px);
  }

  .mkh-material-feature > a:hover .mkh-material-circle img,
  .mkh-material-feature > a:focus-visible .mkh-material-circle img {
    transform: scale(1.035);
  }

  .mkh-material-feature h3 {
    margin: 0 0 7px;
    color: var(--mkh-ink);
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }

  .mkh-material-feature p {
    max-width: 250px;
    margin: 0 auto;
    color: var(--mkh-text);
    font-size: 0.84rem;
    line-height: 1.58;
  }

  /* Material accordion */

  .mkh-material-accordion {
    overflow: hidden;
    margin-top: 52px;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    background: var(--mkh-white);
  }

  .mkh-material-detail {
    border-bottom: 1px solid var(--mkh-line);
  }

  .mkh-material-detail:last-child {
    border-bottom: 0;
  }

  .mkh-material-detail summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px;
    gap: 8px 16px;
    align-items: center;
    min-height: 84px;
    padding: 23px 25px;
    color: var(--mkh-ink);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.22s ease;
  }

  .mkh-material-detail summary::-webkit-details-marker {
    display: none;
  }

  .mkh-material-detail summary:hover,
  .mkh-material-detail summary:focus-visible,
  .mkh-material-detail[open] summary {
    background: var(--mkh-soft);
  }

  .mkh-material-summary-name strong,
  .mkh-material-summary-name small {
    display: block;
  }

  .mkh-material-summary-name strong {
    margin-bottom: 4px;
    font-size: 1.08rem;
  }

  .mkh-material-summary-name small {
    color: var(--mkh-muted);
    font-size: 0.77rem;
    font-weight: 550;
  }

  .mkh-material-summary-text {
    grid-column: 1;
    color: var(--mkh-text);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .mkh-material-detail summary::after {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--mkh-orange);
    content: "+";
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1;
    text-align: center;
  }

  .mkh-material-detail[open] summary::after {
    content: "−";
  }

  .mkh-material-panel {
    display: grid;
    gap: 28px 34px;
    padding: 8px 25px 32px;
    background: var(--mkh-white);
  }

  .mkh-material-specs {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--mkh-line);
    border-radius: 8px;
    background: var(--mkh-line);
  }

  .mkh-material-specs > span {
    min-width: 0;
    padding: 13px 15px;
    background: var(--mkh-soft);
  }

  .mkh-material-specs small,
  .mkh-material-specs strong {
    display: block;
  }

  .mkh-material-specs small {
    margin-bottom: 3px;
    color: var(--mkh-muted);
    font-size: 0.66rem;
    font-weight: 720;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .mkh-material-specs strong {
    color: var(--mkh-ink);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .mkh-material-panel h3 {
    margin: 0 0 8px;
    color: var(--mkh-ink);
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }

  .mkh-material-panel p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.87rem;
    line-height: 1.7;
  }

  .mkh-material-panel a {
    color: var(--mkh-ink);
    font-weight: 750;
    text-decoration-color: var(--mkh-orange);
    text-underline-offset: 4px;
  }

  .mkh-operation-badges,
  .mkh-application-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .mkh-operation-badges li,
  .mkh-application-tags li {
    border: 1px solid var(--mkh-line);
    border-radius: 999px;
    padding: 5px 9px;
    background: var(--mkh-white);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .mkh-operation-badges .is-good {
    border-color: rgba(79, 143, 0, 0.32);
    color: #416f08;
    background: #f3f8ec;
  }

  .mkh-operation-badges .is-conditional {
    border-color: rgba(154, 106, 0, 0.3);
    color: #795500;
    background: #fff9e9;
  }

  .mkh-operation-badges .is-limited {
    border-color: rgba(138, 74, 74, 0.25);
    color: #7b4848;
    background: #faf3f3;
  }

  .mkh-application-tags li {
    color: var(--mkh-text);
    background: var(--mkh-soft);
  }

  .mkh-material-caution {
    margin-top: 10px !important;
    color: var(--mkh-muted) !important;
    font-size: 0.76rem !important;
  }

  /* Examples */

  .mkh-example-grid {
    display: grid;
    gap: 18px;
  }

  .mkh-example-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    background: var(--mkh-white);
  }

  .mkh-example-card figure {
    aspect-ratio: 1;
    margin: 0;
    padding: 14px;
    background: var(--mkh-soft);
  }

  .mkh-example-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mkh-example-copy {
    flex: 1;
    padding: 18px 20px 20px;
  }

  .mkh-example-copy h3 {
    margin: 0 0 6px;
    color: var(--mkh-ink);
    font-size: 1rem;
  }

  .mkh-example-copy p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .mkh-testimonial {
    display: grid;
    gap: 22px;
    align-items: end;
    margin-top: 28px;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 24px;
    background: var(--mkh-soft);
  }

  .mkh-testimonial-label {
    margin: 0 0 10px;
    color: var(--mkh-orange-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .mkh-testimonial blockquote {
    margin: 0;
    color: var(--mkh-ink);
    font-size: clamp(1.05rem, 2.1vw, 1.35rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.5;
  }

  .mkh-testimonial cite {
    color: var(--mkh-text);
    font-size: 0.82rem;
    font-style: normal;
    line-height: 1.55;
  }

  .mkh-testimonial cite strong,
  .mkh-testimonial cite span {
    display: block;
  }

  .mkh-testimonial cite strong {
    color: var(--mkh-ink);
  }

  /* Applications */

  .mkh-application-grid {
    display: grid;
    gap: 12px;
  }

  .mkh-application-card {
    border: 1px solid var(--mkh-line);
    border-radius: 9px;
    padding: 21px;
    background: var(--mkh-white);
  }

  .mkh-application-card h3 {
    margin: 0 0 7px;
    color: var(--mkh-ink);
    font-size: 1rem;
  }

  .mkh-application-card p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  /* Process */

  .mkh-process-grid {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mkh-process-card {
    border-top: 3px solid var(--mkh-orange);
    padding: 21px 0 0;
  }

  .mkh-process-number {
    display: block;
    margin-bottom: 18px;
    color: var(--mkh-orange);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .mkh-process-card h3 {
    margin: 0 0 7px;
    color: var(--mkh-ink);
    font-size: 1.05rem;
  }

  .mkh-process-card p {
    margin: 0;
    color: var(--mkh-text);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  /* SEO text */

  .mkh-seo-grid {
    display: grid;
    gap: 24px;
  }

  .mkh-seo-copy p {
    margin: 0 0 17px;
    color: var(--mkh-text);
    line-height: 1.72;
  }

  /* FAQ */

  .mkh-faq-grid {
    display: grid;
    gap: 30px;
  }

  .mkh-faq-list {
    border-top: 1px solid var(--mkh-line);
  }

  .mkh-faq-list details {
    border-bottom: 1px solid var(--mkh-line);
  }

  .mkh-faq-list summary {
    position: relative;
    padding: 19px 38px 19px 0;
    color: var(--mkh-ink);
    font-size: 0.9rem;
    font-weight: 730;
    cursor: pointer;
    list-style: none;
  }

  .mkh-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .mkh-faq-list summary::after {
    position: absolute;
    top: 15px;
    right: 3px;
    color: var(--mkh-orange);
    content: "+";
    font-size: 1.4rem;
  }

  .mkh-faq-list details[open] summary::after {
    content: "−";
  }

  .mkh-faq-list p {
    max-width: 720px;
    margin: 0 0 20px;
    padding-right: 25px;
    color: var(--mkh-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* Simple quote form */

  .mkh-quote {
    padding: 72px 0;
    background: var(--mkh-soft);
  }

  .mkh-quote-wrap {
    max-width: 860px;
    margin-inline: auto;
  }

  .mkh-quote-heading {
    max-width: 680px;
    margin: 0 auto 30px;
    text-align: center;
  }

  .mkh-quote-heading p:last-child {
    margin: 15px auto 0;
    color: var(--mkh-text);
    line-height: 1.65;
  }

  .mkh-form {
    position: relative;
    border: 1px solid var(--mkh-line);
    border-radius: var(--mkh-radius);
    padding: 20px;
    background: var(--mkh-white);
  }

  .mkh-form-grid {
    display: grid;
    gap: 16px;
  }

  .mkh-field {
    margin-bottom: 16px;
  }

  .mkh-field label {
    display: block;
    margin-bottom: 7px;
    color: var(--mkh-ink);
    font-size: 0.84rem;
    font-weight: 730;
  }

  .mkh-field input,
  .mkh-field textarea {
    width: 100%;
    border: 1px solid #cbd3d5;
    border-radius: 7px;
    padding: 12px 13px;
    color: var(--mkh-ink);
    background: var(--mkh-white);
  }

  .mkh-field input {
    min-height: 48px;
  }

  .mkh-field textarea {
    min-height: 170px;
    resize: vertical;
  }

  .mkh-field input:focus,
  .mkh-field textarea:focus {
    border-color: var(--mkh-orange);
    outline: 3px solid rgba(116, 194, 0, 0.16);
  }

  .mkh-field-help,
  .mkh-form-note {
    margin: 7px 0 0;
    color: var(--mkh-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .mkh-checkbox {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    margin: 2px 0 18px;
    color: var(--mkh-text);
    font-size: 0.79rem;
    line-height: 1.5;
  }

  .mkh-checkbox input {
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    accent-color: var(--mkh-orange);
  }

  .mkh-checkbox a {
    color: var(--mkh-ink);
    font-weight: 700;
  }

  .mkh-form-status {
    display: none;
    margin-bottom: 14px;
    border-radius: 7px;
    padding: 11px 13px;
    font-size: 0.84rem;
  }

  .mkh-form-status.is-error,
  .mkh-form-status.is-success {
    display: block;
  }

  .mkh-form-status.is-error {
    color: #7b2525;
    background: #fdecec;
  }

  .mkh-form-status.is-success {
    color: #14583b;
    background: #e6f6ee;
  }

  .mkh-form .mkh-btn {
    width: 100%;
  }

  .mkh-form-note {
    text-align: center;
  }

  .mkh-honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (min-width: 640px) {
