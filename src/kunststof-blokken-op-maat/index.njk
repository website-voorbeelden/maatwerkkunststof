---
layout: "base.njk"
title: "Kunststof blokken | Op maat gezaagd en bewerkt"
description: "Kunststof blokken en blokjes op maat in HDPE, HMPE, POM, PVC, PTFE en meer. Enkelstuk of serie, gezaagd of CNC-bewerkt. Vraag vrijblijvend een offerte aan."
image: "/assets/images/kunststof-blokken.webp"
imageAlt: "Massieve kunststof blokken op maat in verschillende afmetingen"
preloadImage: "/assets/images/kunststof-blokken-480.webp"
preloadImageSrcset: "/assets/images/kunststof-blokken-480.webp 480w, /assets/images/kunststof-blokken-640.webp 640w, /assets/images/kunststof-blokken-800.webp 800w, /assets/images/kunststof-blokken.webp 1600w"
preloadImageSizes: "(min-width: 1228px) 581px, (min-width: 920px) 50vw, calc(100vw - 32px)"
bodyClass: "mkb-page"
---

{% set contactEmail = site.email or "offerte@maatwerkkunststof.nl" %}

<style>
  body.mkb-page {
    --mkb-ink: #142b33;
    --mkb-text: #53636a;
    --mkb-muted: #748188;
    --mkb-line: #dce2e3;
    --mkb-soft: #f3f7ef;
    --mkb-white: #ffffff;
    --mkb-orange: #74c200;
    --mkb-orange-dark: #4f8f00;
    --mkb-green: #74c200;
    --mkb-green-dark: #4f8f00;
    --mkb-whatsapp: #128c4a;
    --mkb-whatsapp-dark: #0f6f3b;
    --mkb-radius: 14px;
    --mkb-shadow: 0 22px 55px rgba(20, 38, 46, 0.1);
    --mkb-container: 1180px;
    background: var(--mkb-white);
  }

  body.mkb-page main {
    overflow: clip;
  }

  .mkb-container {
    width: min(calc(100% - 32px), var(--mkb-container));
    margin-inline: auto;
  }

  .mkb-section {
    padding: 66px 0;
  }

  .mkb-section-soft {
    background: var(--mkb-soft);
  }

  .mkb-eyebrow {
    margin: 0 0 10px;
    color: var(--mkb-orange-dark);
    font-size: 0.72rem;
    font-weight: 840;
    letter-spacing: 0.13em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .mkb-heading {
    max-width: 780px;
    margin: 0;
    color: var(--mkb-ink);
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 770;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .mkb-section-intro {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  .mkb-section-intro > p,
  .mkb-copy p:not(.mkb-eyebrow) {
    margin: 0;
    color: var(--mkb-text);
    line-height: 1.72;
  }

  .mkb-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--mkb-orange);
    border-radius: 8px;
    padding: 13px 20px;
    color: var(--mkb-white);
    background: var(--mkb-orange);
    font-size: 0.92rem;
    font-weight: 780;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
  }

  .mkb-btn:hover,
  .mkb-btn:focus-visible {
    border-color: var(--mkb-orange-dark);
    background: var(--mkb-orange-dark);
    transform: translateY(-1px);
  }

  .mkb-btn-secondary {
    border-color: var(--mkb-ink);
    color: var(--mkb-ink);
    background: transparent;
  }

  .mkb-btn-secondary:hover,
  .mkb-btn-secondary:focus-visible {
    color: var(--mkb-white);
    background: var(--mkb-ink);
  }

  .mkb-btn-green {
    border-color: var(--mkb-green);
    color: var(--mkb-white);
    background: var(--mkb-green);
  }

  .mkb-btn-green:hover,
  .mkb-btn-green:focus-visible {
    border-color: var(--mkb-green-dark);
    color: var(--mkb-white);
    background: var(--mkb-green);
  }

  .mkb-btn-whatsapp {
    border-color: var(--mkb-line);
    color: var(--mkb-ink);
    background: var(--mkb-white);
  }

  .mkb-btn-whatsapp:hover,
  .mkb-btn-whatsapp:focus-visible {
    border-color: var(--mkb-whatsapp);
    color: var(--mkb-ink);
    background: var(--mkb-soft);
  }

  .mkb-whatsapp-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    margin-right: 8px;
    color: var(--mkb-whatsapp);
    fill: currentColor;
  }

  /* Productintro met galerij en offerteformulier */

  .mkb-product {
    padding: 28px 0 62px;
    background: linear-gradient(180deg, #f7f9f8 0%, #ffffff 58%);
  }

  .mkb-product-grid {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .mkb-product-info {
    order: 2;
  }

  .mkb-product-gallery {
    order: 1;
    min-width: 0;
  }

  .mkb-product h1 {
    max-width: 660px;
    margin: 0 0 17px;
    color: var(--mkb-ink);
    font-size: clamp(2.5rem, 9vw, 4.55rem);
    font-weight: 795;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .mkb-product-lead {
    max-width: 670px;
    margin: 0 0 20px;
    color: var(--mkb-text);
    font-size: clamp(1rem, 2vw, 1.13rem);
    line-height: 1.65;
  }

  .mkb-gallery-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--mkb-line);
    border-radius: var(--mkb-radius);
    background: #edf1ef;
    box-shadow: var(--mkb-shadow);
  }

  .mkb-gallery-open {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .mkb-product-gallery:focus:not(:focus-visible),
  .mkb-gallery-open:focus:not(:focus-visible) {
    outline: none;
  }

  .mkb-gallery-main {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mkb-gallery-control {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 50%;
    padding: 0;
    color: var(--mkb-ink);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 8px 20px rgba(20, 38, 46, 0.16);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .mkb-gallery-control svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .mkb-gallery-prev {
    left: 12px;
  }

  .mkb-gallery-next {
    right: 12px;
  }

  .mkb-gallery-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    padding: 2px 1px 8px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scroll-snap-type: inline mandatory;
  }

  .mkb-gallery-thumb {
    flex: 0 0 82px;
    width: 82px;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 9px;
    padding: 0;
    background: #edf1ef;
    cursor: pointer;
    scroll-snap-align: start;
  }

  .mkb-gallery-thumb[aria-pressed="true"] {
    border-color: var(--mkb-orange);
    box-shadow: 0 0 0 2px rgba(116, 194, 0, 0.16);
  }

  .mkb-gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Compact formulier */

  .mkb-form {
    position: relative;
    border: 1px solid var(--mkb-line);
    border-radius: var(--mkb-radius);
    padding: 20px;
    background: var(--mkb-white);
    box-shadow: 0 16px 40px rgba(20, 38, 46, 0.08);
  }

  .mkb-form-head {
    margin-bottom: 17px;
  }

  .mkb-form-head strong {
    display: block;
    margin-bottom: 3px;
    color: var(--mkb-ink);
    font-size: 1.08rem;
  }

  .mkb-form-head span {
    display: block;
    color: var(--mkb-text);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .mkb-form-row {
    display: grid;
    gap: 12px;
  }

  .mkb-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .mkb-field {
    margin-bottom: 12px;
  }

  .mkb-field label {
    display: block;
    margin-bottom: 6px;
    color: var(--mkb-ink);
    font-size: 0.79rem;
    font-weight: 740;
  }

  .mkb-field input,
  .mkb-field textarea {
    width: 100%;
    border: 1px solid #c8d1d3;
    border-radius: 7px;
    padding: 12px 13px;
    color: var(--mkb-ink);
    background: var(--mkb-white);
  }

  .mkb-field input {
    min-height: 50px;
  }

  .mkb-field textarea {
    min-height: 132px;
    resize: vertical;
  }

  .mkb-field input:focus,
  .mkb-field textarea:focus {
    border-color: var(--mkb-orange);
    outline: 3px solid rgba(116, 194, 0, 0.16);
  }

  .mkb-field input::placeholder,
  .mkb-field textarea::placeholder {
    color: #8a969b;
    opacity: 1;
  }

  .mkb-field-help,
  .mkb-form-note {
    margin: 6px 0 0;
    color: var(--mkb-muted);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .mkb-file-label {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px dashed #aebabc;
    border-radius: 7px;
    padding: 10px;
    color: var(--mkb-ink);
    background: #fafbfa;
    font-size: 0.77rem;
    font-weight: 720;
    cursor: pointer;
  }

  .mkb-file-label input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .mkb-file-label:focus-within {
    outline: 3px solid rgba(116, 194, 0, 0.22);
    outline-offset: 2px;
  }

  .mkb-form .mkb-btn {
    width: 100%;
  }

  .mkb-form-note {
    text-align: center;
  }

  .mkb-form .form-status {
    margin-bottom: 12px;
  }

  .mkb-form-usps {
    display: grid;
    gap: 11px;
    margin: 20px 2px 0;
    padding: 0;
    list-style: none;
  }

  .mkb-form-usps li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--mkb-ink);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .mkb-form-usps svg {
    flex: 0 0 19px;
    width: 19px;
    height: 19px;
    color: var(--mkb-green);
  }

  .mkb-form-contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    margin-top: 18px;
  }

  .mkb-form-contact span {
    color: var(--mkb-text);
    font-size: 0.78rem;
  }

  .mkb-form-contact .mkb-btn {
    width: auto;
    min-height: 42px;
    padding: 10px 15px;
    font-size: 0.8rem;
  }

  .mkb-form-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 12px;
    color: var(--mkb-muted);
    font-size: 0.7rem;
  }

  .mkb-form-trust img {
    width: auto;
    max-width: 92px;
    height: 30px;
    object-fit: contain;
  }

  .mkb-honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Inhoud */

  .mkb-card-grid,
  .mkb-material-grid,
  .mkb-process-grid,
  .mkb-application-grid,
  .mkb-related-grid {
    display: grid;
    gap: 14px;
  }

  .mkb-material-grid {
    align-items: start;
  }

  .mkb-proof {
    position: relative;
    z-index: 2;
    margin-top: -28px;
  }

  .mkb-proof-grid {
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(20, 43, 51, 0.12);
    border-radius: var(--mkb-radius);
    background: var(--mkb-white);
    box-shadow: 0 18px 46px rgba(20, 43, 51, 0.1);
  }

  .mkb-proof-item {
    display: grid;
    min-height: 142px;
    place-content: center;
    gap: 5px;
    padding: 24px;
    text-align: center;
  }

  .mkb-proof-item + .mkb-proof-item {
    border-top: 1px solid var(--mkb-line);
  }

  .mkb-proof-number {
    color: var(--mkb-green-dark);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .mkb-proof-label {
    color: var(--mkb-ink);
    font-size: 0.86rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .mkb-definition-grid,
  .mkb-expert-grid {
    display: grid;
    gap: 24px;
  }

  .mkb-definition-panel,
  .mkb-expert-panel {
    border: 1px solid rgba(116, 194, 0, 0.34);
    border-radius: var(--mkb-radius);
    padding: 24px;
    background: linear-gradient(145deg, #fbfdf8 0%, var(--mkb-soft) 100%);
  }

  .mkb-definition-panel h3,
  .mkb-expert-panel h3,
  .mkb-process-heading {
    margin: 0 0 12px;
    color: var(--mkb-ink);
    font-size: 1.08rem;
  }

  .mkb-inline-links {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .mkb-inline-links a {
    color: var(--mkb-green-dark);
    font-weight: 750;
    text-underline-offset: 3px;
  }

  .mkb-card,
  .mkb-price-card,
  .mkb-process-card,
  .mkb-application-card {
    border: 1px solid var(--mkb-line);
    border-radius: 10px;
    padding: 22px;
    background: var(--mkb-white);
  }

  .mkb-card h3,
  .mkb-price-card h3,
  .mkb-process-card h3,
  .mkb-application-card h3 {
    margin: 0 0 7px;
    color: var(--mkb-ink);
    font-size: 1rem;
  }

  .mkb-card p,
  .mkb-price-card p,
  .mkb-process-card p,
  .mkb-application-card p {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.83rem;
    line-height: 1.57;
  }

  .mkb-material-detail {
    overflow: hidden;
    border: 1px solid var(--mkb-line);
    border-radius: 11px;
    background: var(--mkb-white);
    transition: border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .mkb-material-detail[open] {
    border-color: rgba(79, 143, 0, 0.55);
    box-shadow: 0 12px 30px rgba(20, 43, 51, 0.07);
  }

  .mkb-material-detail summary {
    position: relative;
    padding: 21px 54px 21px 22px;
    color: var(--mkb-ink);
    cursor: pointer;
    list-style: none;
  }

  .mkb-material-detail summary::-webkit-details-marker {
    display: none;
  }

  .mkb-material-detail summary::after {
    position: absolute;
    top: 50%;
    right: 22px;
    color: var(--mkb-green-dark);
    content: "+";
    font-size: 1.55rem;
    font-weight: 500;
    transform: translateY(-50%);
  }

  .mkb-material-detail[open] summary::after {
    content: "−";
  }

  .mkb-material-detail summary strong,
  .mkb-material-detail summary span {
    display: block;
  }

  .mkb-material-detail summary strong {
    margin-bottom: 4px;
    font-size: 1rem;
  }

  .mkb-material-detail summary span {
    color: var(--mkb-text);
    font-size: 0.78rem;
    line-height: 1.48;
  }

  .mkb-material-content {
    border-top: 1px solid var(--mkb-line);
    padding: 22px;
  }

  .mkb-material-description {
    max-width: 930px;
    margin: 0 0 20px;
    color: var(--mkb-text);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .mkb-material-facts {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .mkb-material-facts div {
    display: grid;
    gap: 3px;
    align-content: start;
  }

  .mkb-material-facts .mkb-material-highlight {
    border-left: 3px solid var(--mkb-green);
    border-radius: 0 8px 8px 0;
    padding: 13px 15px;
    background: var(--mkb-soft);
  }

  .mkb-material-facts dt {
    color: var(--mkb-ink);
    font-size: 0.72rem;
    font-weight: 820;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mkb-material-facts dd {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.82rem;
    line-height: 1.58;
  }

  .mkb-material-link {
    display: inline-flex;
    margin-top: 20px;
    color: var(--mkb-green-dark);
    font-size: 0.82rem;
    font-weight: 780;
    text-decoration: none;
  }

  .mkb-material-link:hover,
  .mkb-material-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mkb-callout {
    display: grid;
    gap: 18px;
    align-items: center;
    margin-top: 22px;
    border-radius: 12px;
    padding: 22px;
    border: 1px solid rgba(116, 194, 0, 0.42);
    color: var(--mkb-ink);
    background: var(--mkb-white);
    box-shadow: 0 12px 32px rgba(20, 43, 51, 0.06);
  }

  .mkb-callout strong {
    display: block;
    margin-bottom: 5px;
    font-size: 1rem;
  }

  .mkb-callout p {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .mkb-price-story {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  .mkb-price-copy {
    display: grid;
    gap: 16px;
  }

  .mkb-price-copy p,
  .mkb-advice-copy p {
    margin: 0;
    color: var(--mkb-text);
    line-height: 1.74;
  }

  .mkb-price-note {
    border-left: 4px solid var(--mkb-green);
    border-radius: 0 12px 12px 0;
    padding: 23px 24px;
    background: var(--mkb-white);
  }

  .mkb-price-note h3 {
    margin: 0 0 9px;
    color: var(--mkb-ink);
    font-size: 1.04rem;
  }

  .mkb-price-note p {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.86rem;
    line-height: 1.67;
  }

  .mkb-advice-copy {
    display: grid;
    max-width: 880px;
    gap: 14px;
    margin-bottom: 34px;
  }

  .mkb-case-grid {
    display: grid;
    gap: 18px;
  }

  .mkb-case-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--mkb-line);
    border-radius: var(--mkb-radius);
    background: var(--mkb-white);
    box-shadow: 0 12px 30px rgba(20, 43, 51, 0.06);
  }

  .mkb-case-image {
    margin: 0;
    background: #e9eeeb;
  }

  .mkb-case-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .mkb-case-content {
    display: grid;
    gap: 13px;
    align-content: center;
    padding: 24px;
  }

  .mkb-case-content h3 {
    margin: 0;
    color: var(--mkb-ink);
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.18;
  }

  .mkb-case-content p {
    margin: 0;
    color: var(--mkb-text);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .mkb-case-label {
    color: var(--mkb-green-dark);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .mkb-process-card {
    position: relative;
    padding-top: 62px;
  }

  .mkb-process-number {
    position: absolute;
    top: 20px;
    left: 22px;
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 50%;
    color: var(--mkb-white);
    background: var(--mkb-green);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .mkb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .mkb-split {
    display: grid;
    gap: 34px;
    align-items: center;
  }

  .mkb-split-image {
    overflow: hidden;
    aspect-ratio: 1;
    margin: 0;
    border-radius: var(--mkb-radius);
    background: #edf1ef;
  }

  .mkb-split-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mkb-copy {
    display: grid;
    gap: 16px;
  }

  .mkb-checks {
    display: grid;
    gap: 10px;
    margin: 5px 0 0;
    padding: 0;
    list-style: none;
  }

  .mkb-checks li {
    position: relative;
    padding-left: 25px;
    color: var(--mkb-ink);
    font-size: 0.86rem;
    font-weight: 690;
  }

  .mkb-checks li::before {
    position: absolute;
    top: 0.28em;
    left: 1px;
    width: 12px;
    height: 7px;
    border-bottom: 2px solid var(--mkb-green-dark);
    border-left: 2px solid var(--mkb-green-dark);
    content: "";
    transform: rotate(-45deg);
  }

  .mkb-related-card {
    display: block;
    border: 1px solid var(--mkb-line);
    border-radius: 10px;
    padding: 21px;
    color: var(--mkb-ink);
    background: var(--mkb-white);
    text-decoration: none;
  }

  .mkb-related-card strong,
  .mkb-related-card span {
    display: block;
  }

  .mkb-related-card strong {
    margin-bottom: 4px;
  }

  .mkb-related-card span {
    color: var(--mkb-text);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .mkb-related-card:hover,
  .mkb-related-card:focus-visible {
    border-color: var(--mkb-orange);
  }

  .mkb-faq-grid {
    display: grid;
    gap: 30px;
  }

  .mkb-faq-list {
    border-top: 1px solid var(--mkb-line);
  }

  .mkb-faq-list details {
    border-bottom: 1px solid var(--mkb-line);
  }

  .mkb-faq-list summary {
    position: relative;
    padding: 19px 38px 19px 0;
    color: var(--mkb-ink);
    font-size: 0.9rem;
    font-weight: 740;
    cursor: pointer;
    list-style: none;
  }

  .mkb-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .mkb-faq-list summary::after {
    position: absolute;
    top: 15px;
    right: 3px;
    color: var(--mkb-orange);
    content: "+";
    font-size: 1.4rem;
  }

  .mkb-faq-list details[open] summary::after {
    content: "−";
  }

  .mkb-faq-list p {
    max-width: 760px;
    margin: 0 0 20px;
    padding-right: 25px;
    color: var(--mkb-text);
    font-size: 0.85rem;
    line-height: 1.62;
  }

  .mkb-final {
    padding: 56px 0;
    color: var(--mkb-ink);
    background: var(--mkb-soft);
  }

  .mkb-final-inner {
    display: grid;
    gap: 22px;
    align-items: center;
  }

  .mkb-final h2 {
    max-width: 720px;
    margin: 0 0 8px;
    color: var(--mkb-ink);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }

  .mkb-final p {
    max-width: 720px;
    margin: 0;
    color: var(--mkb-text);
  }

  /* Vergrote foto */

  .mkb-gallery-dialog {
    width: min(94vw, 940px);
    max-height: 94vh;
    border: 0;
    border-radius: 14px;
    padding: 0;
    background: #101e25;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.4);
  }

  .mkb-gallery-dialog::backdrop {
    background: rgba(8, 15, 19, 0.78);
  }

  .mkb-gallery-dialog img {
    width: 100%;
    max-height: 88vh;
    object-fit: contain;
  }

  .mkb-gallery-close {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: var(--mkb-white);
    background: rgba(20, 38, 46, 0.86);
    font-size: 1.35rem;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .mkb-container {
      width: min(calc(100% - 48px), var(--mkb-container));
    }

    .mkb-form-row,
    .mkb-card-grid,
    .mkb-material-grid,
    .mkb-price-grid,
    .mkb-application-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mkb-proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-proof-item + .mkb-proof-item {
      border-top: 0;
      border-left: 1px solid var(--mkb-line);
    }

    .mkb-related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-callout {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 24px;
    }
  }

  @media (min-width: 920px) {
    .mkb-product {
      padding: 52px 0 82px;
    }

    .mkb-product-grid {
      grid-template-columns: minmax(0, 1.04fr) minmax(440px, 0.96fr);
      gap: 62px;
    }

    .mkb-product-gallery {
      position: sticky;
      top: calc(var(--header-height) + 24px);
    }

    .mkb-product-info {
      order: 2;
    }

    .mkb-gallery-thumb {
      flex-basis: auto;
      width: auto;
    }

    .mkb-gallery-thumbs {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow: visible;
    }

    .mkb-section {
      padding-block: 92px;
    }

    .mkb-section-intro {
      grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
      gap: 60px;
      align-items: end;
      margin-bottom: 40px;
    }

    .mkb-card-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkb-application-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-definition-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.75fr);
      gap: 64px;
      align-items: center;
    }

    .mkb-expert-grid {
      grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.28fr);
      gap: 44px;
      align-items: start;
    }

    .mkb-price-story {
      grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
      gap: 64px;
    }

    .mkb-case-card {
      grid-template-columns: 300px minmax(0, 1fr);
    }

    .mkb-case-image img {
      aspect-ratio: auto;
      min-height: 260px;
    }

    .mkb-case-content {
      padding: 34px 38px;
    }

    .mkb-process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-split {
      grid-template-columns: minmax(400px, 0.88fr) minmax(0, 1.12fr);
      gap: 76px;
    }

    .mkb-split-reverse .mkb-split-image {
      order: 2;
    }

    .mkb-split-reverse .mkb-copy {
      order: 1;
    }

    .mkb-faq-grid {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 80px;
    }

    .mkb-final-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mkb-gallery-thumbs {
      scroll-behavior: auto;
