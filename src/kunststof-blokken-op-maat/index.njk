  .mkb-form {
    position: relative;
    border: 1px solid var(--mkb-line);
    border-radius: var(--mkb-radius);
    padding: 20px;
    background: var(--mkb-white);
  }

  .mkb-form-grid {
    display: grid;
    gap: 16px;
  }

  .mkb-field {
    margin-bottom: 16px;
  }

  .mkb-field label {
    display: block;
    margin-bottom: 7px;
    color: var(--mkb-ink);
    font-size: 0.84rem;
