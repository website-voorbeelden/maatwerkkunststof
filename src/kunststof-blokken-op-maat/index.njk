  .mkb-form-status.is-error,
  .mkb-form-status.is-success {
    display: block;
  }

  .mkb-form-status.is-error {
    color: #7b2525;
    background: #fdecec;
  }

  .mkb-form-status.is-success {
    color: #14583b;
    background: #e6f6ee;
  }

  .mkb-form .mkb-btn {
    width: 100%;
  }

  .mkb-form-note {
    text-align: center;
  }

  .mkb-honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (min-width: 640px) {
    .mkb-container {
      width: min(calc(100% - 48px), var(--mkb-container));
    }

    .mkb-hero-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-option-grid,
    .mkb-processing-grid,
    .mkb-application-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mkb-gallery,
    .mkb-related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .mkb-hero {
      padding: 48px 0 82px;
    }

    .mkb-hero-grid {
      grid-template-columns:
        minmax(0, 1.08fr)
        minmax(420px, 0.92fr);
      gap: 76px;
    }

    .mkb-section,
    .mkb-quote {
      padding-block: 94px;
    }

    .mkb-section-intro {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(330px, 0.72fr);
      gap: 60px;
      align-items: end;
      margin-bottom: 42px;
    }

    .mkb-split {
      grid-template-columns:
        minmax(400px, 0.85fr)
        minmax(0, 1.15fr);
      gap: 76px;
    }

    .mkb-option-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-processing-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mkb-application-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mkb-material-row {
      grid-template-columns:
        minmax(150px, 0.55fr)
        minmax(0, 1.4fr)
        minmax(220px, 0.9fr);
      gap: 26px;
      align-items: start;
      padding: 20px 24px;
    }

    .mkb-material-row-head {
      display: grid;
      color: var(--mkb-white);
      background: var(--mkb-ink);
      font-size: 0.76rem;
    }

    .mkb-material-row-head strong {
      color: var(--mkb-white);
    }

    .mkb-material-footer {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 24px;
    }

    .mkb-content-grid,
    .mkb-faq-grid {
      grid-template-columns:
        minmax(0, 0.72fr)
        minmax(0, 1.28fr);
      gap: 80px;
    }

    .mkb-form {
      padding: 30px;
    }
  }
</style>

